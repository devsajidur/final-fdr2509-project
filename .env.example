# ==============================================================================
# Mack Anthem® - Firebase Configuration Environment Variables
# Copy this file to .env.local and fill in the values from Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration
# ==============================================================================

# 1. Firebase Web API Key (Found in Project Settings -> General -> Web API Key)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here

# 2. Firebase Auth Domain (Usually: <project-id>.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# 3. Firebase Project ID (Found in Project Settings -> General -> Project ID)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id

# 4. Firebase Cloud Storage Bucket (Usually: <project-id>.appspot.com or firebasestorage.app)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# 5. Firebase Cloud Messaging Sender ID (Found in Project Settings -> Cloud Messaging)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# 6. Firebase Web App ID (Found in Project Settings -> General -> App ID: 1:xxx:web:yyy)
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# 7. Firebase Realtime Database URL (Found in Realtime Database tab -> Top URL)
# Needed for ultra-low latency GuardDog Connect live CAN-bus telematics gauges
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

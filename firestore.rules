rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only collections for website dynamic content
    match /specifications/{specId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /features/{featureId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dealers/{dealerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public lead generation: Allow visitor creation with validation, deny public listing
    match /quotes/{quoteId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*\\..*');
      allow update, delete: if request.auth != null;
    }

    match /leads/{leadId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*\\..*');
      allow update, delete: if request.auth != null;
    }

    match /testdrives/{driveId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*\\..*');
      allow update, delete: if request.auth != null;
    }

    // Each signed-in user may only access their own profile document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

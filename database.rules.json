{
  "rules": {
    "specifications": {
      ".read": true,
      ".write": "auth != null"
    },
    "features": {
      ".read": true,
      ".write": "auth != null"
    },
    "gallery": {
      ".read": true,
      ".write": "auth != null"
    },
    "quotes": {
      ".read": "auth != null",
      "$quoteId": {
        ".write": "auth != null || !data.exists()",
        ".validate": "newData.hasChildren(['name', 'email', 'selectedEngine'])"
      }
    },
    "leads": {
      ".read": "auth != null",
      "$leadId": {
        ".write": "auth != null || !data.exists()",
        ".validate": "newData.hasChildren(['name', 'email', 'message'])"
      }
    },
    "testdrives": {
      ".read": "auth != null",
      "$driveId": {
        ".write": "auth != null || !data.exists()",
        ".validate": "newData.hasChildren(['customerName', 'email', 'model', 'preferredDate'])"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "connection_test": {
      ".read": true,
      ".write": true
    }
  }
}
